function renderDados(){el('content').innerHTML=`<div class="card"><h3>Armazenamento centralizado</h3><p>Os dados são mantidos no banco de dados do servidor. Não dependem do armazenamento deste navegador.</p><p><strong>${db.clients.length} clientes · ${db.products.length} produtos · ${db.orders.length} pedidos.</strong></p><div class="actions">${button('Exportar dados do negócio (.json)','export-data','','dark')}</div><p class="tiny muted">Este arquivo inclui contatos e pedidos. Guarde-o em lugar privado. Não contém senhas ou contas de acesso.</p></div><div class="card danger-zone"><h3>Migração da versão antiga</h3><p>Se você já registrou pedidos na versão HTML anterior, exporte um backup JSON daquela versão e importe aqui. A importação é permitida <strong>somente antes de criar qualquer pedido ou produto no sistema online</strong>. Ela substitui os clientes iniciais e importa os clientes, os produtos, os pedidos e os pagamentos do backup.</p><label class="btn alt file-btn">Selecionar backup antigo (.json)<input id="old-backup" type="file" accept=".json,application/json"></label></div><div class="card"><h3>Backups do servidor</h3><p>O servidor inclui uma rotina automática de cópia do banco de dados a cada 24 horas com retenção local de 30 dias quando implantado pelo arquivo Docker Compose. Também é necessário copiar os backups para outro local protegido contra perda do servidor.</p></div>`;el('old-backup').onchange=async e=>{let f=e.target.files?.[0];if(!f)return;try{let backup=JSON.parse(await f.text());if(!confirm(`Importar o backup ${f.name}? Os clientes iniciais serão substituídos, e a importação só funciona antes de haver pedidos ou produtos neste servidor.`))return;let response=await api('/api/import','POST',backup);await sync();go('clientes');toast(`Importados ${response.clients} clientes e ${response.orders} pedidos.`)}catch(err){toast(err.message,true)}}}
function renderConta(){el('content').innerHTML=`<div class="card"><h3>Minha conta</h3><p>${esc(me.name)} · ${esc(me.email)} · ${esc(LABEL[me.role])}</p><div class="actions">${button('Alterar senha','password','','dark')}${me.totpEnabled?'<span class="pill ok">Autenticação em duas etapas ativada</span>':button('Ativar duas etapas','setup-totp')}</div></div><div class="notice">Uma senha provisória de 6 dígitos pode continuar em uso sem troca, mas é menos resistente a tentativas de acesso. Recomendamos ativar a autenticação em duas etapas. Para redefinir o segundo fator, procure o administrador.</div>`}
function openPassword(required=false){modal(`${head(required?'Troque a senha provisória':'Alterar senha')}<p>${required?'É obrigatório trocar a senha temporária antes de usar o sistema.':'Sua nova senha deve ter pelo menos 4 caracteres.'}</p><form id="pass-form">${field('old-pass','Senha atual','','password','required autocomplete="current-password"')}${field('new-pass','Nova senha (mín. 4 caracteres)','','password','required minlength="4" autocomplete="new-password"')}${field('confirm-pass','Repita a nova senha','','password','required minlength="4" autocomplete="new-password"')}<div class="footer-buttons"><button class="btn">Salvar nova senha</button></div></form>`);el('pass-form').onsubmit=async e=>{e.preventDefault();if(el('new-pass').value!==el('confirm-pass').value){toast('As senhas não coincidem.',true);return}try{await api('/api/password','POST',{oldPassword:el('old-pass').value,newPassword:el('new-pass').value});csrf='';me=null;showLogin();toast('Senha atualizada. Faça login novamente.')}catch(err){toast(err.message,true)}};if(required){el('modal-root').querySelectorAll('[data-close]').forEach(x=>x.remove());el('modal-root').querySelector('.modal-back').onclick=null}}
async function setupTotp(){try{let r=await api('/api/totp/setup','POST',{});modal(`${head('Ativar autenticação em duas etapas')}<p>No seu aplicativo autenticador (Google Authenticator, Microsoft Authenticator etc.), adicione uma conta manualmente com a chave abaixo. Depois digite o código de seis dígitos para ativar.</p><p class="badge" style="font-family:monospace">${esc(r.secret)}</p><p class="tiny muted">Guarde a chave de recuperação com segurança. Não a compartilhe nem salve em locais públicos.</p><form id="totp-form">${field('totp-code','Código de 6 dígitos','','text','required inputmode="numeric" minlength="6" maxlength="6" pattern="[0-9]{6}"')}<div class="footer-buttons"><button class="btn">Ativar</button></div></form>`);el('totp-form').onsubmit=async e=>{e.preventDefault();try{await api('/api/totp/confirm','POST',{code:el('totp-code').value});me.totpEnabled=true;closeModal();render();toast('Autenticação em duas etapas ativada.')}catch(err){toast(err.message,true)}}}catch(e){toast(e.message,true)}}
function download(filename,text,type='text/plain;charset=utf-8'){let blob=new Blob([text],{type}),url=URL.createObjectURL(blob),a=document.createElement('a');a.href=url;a.download=filename;a.click();setTimeout(()=>URL.revokeObjectURL(url),1200)}
function pendingModalAction(action,button){switch(action){case 'edit-client':return openClient(button.dataset.id);case 'delete-client':{
 if(!allowed('admin'))return;
 const id=button.dataset.id,c=db.clients.find(x=>x.id===id);
 if(!c)return toast('Cliente não encontrado.',true);
 if(!confirm(`Excluir o cliente “${c.name}” do cadastro?\n\nCaso existam pedidos já quitados, eles e seus pagamentos serão preservados no histórico. Clientes com pagamentos pendentes precisam ser quitados antes da exclusão.`))return;
 return change('/api/clients/'+encodeURIComponent(id),'DELETE',{},'Cliente excluído do cadastro.');}
case 'edit-product':return openProduct(button.dataset.id);case 'delete-product':{
 if(!allowed('admin'))return;
 const id=button.dataset.id,p=db.products.find(x=>x.id===id&&!x.archived);
 if(!p)return toast('Produto não encontrado.',true);
 if(!confirm(`Excluir o produto “${p.name}” do cardápio? Ele deixará de estar disponível para novos pedidos. Pedidos e extratos anteriores serão preservados.`))return;
 return change('/api/products/'+encodeURIComponent(id),'DELETE',{},'Produto excluído do cardápio.');}
case 'view-order':return openOrderDetail(button.dataset.id);case 'edit-order':return openOrder(button.dataset.id);case 'pay-order':return openPay(button.dataset.id);case 'statement':return openStatement(button.dataset.id);case 'share':return shareStatement(button.dataset.id);case 'bulk':return bulkPay(button.dataset.id);case 'edit-user':return editUser(button.dataset.id);case 'reset-user':return resetUser(button.dataset.id);case 'delete-user':return deleteUser(button.dataset.id);case 'audit-detail':{let a=window.__auditEvents?.[Number(button.dataset.id)];if(a)modal(`${head('Detalhes da alteração')}<p>${esc(a.at)} · ${esc(a.actor_email)} · ${esc(a.event)}</p><h4>Antes</h4><pre class="soft" style="white-space:pre-wrap;overflow-wrap:anywhere">${esc(a.before_json||'—')}</pre><h4>Depois</h4><pre class="soft" style="white-space:pre-wrap;overflow-wrap:anywhere">${esc(a.after_json||'—')}</pre>`);return}case 'password':return openPassword();case 'setup-totp':return setupTotp();case 'add-menu':{if(el('order-form'))el('order-form').dataset.dirty='true';let cat=button.dataset.id;let p=db.products.find(p=>p.category===cat&&p.active&&!p.archived);if(!p){toast('Cadastre um produto disponível de '+cat+' no cardápio.',true);return}draft.push({kind:'menu',productId:p.id,name:p.name,category:cat,qty:1,priceCents:p.priceCents});return renderDraft()}case 'add-extra':if(el('order-form'))el('order-form').dataset.dirty='true';draft.push({kind:'extra',productId:null,name:'',category:'Adicional',qty:1,priceCents:0,priceText:'0,00'});return renderDraft();case 'decrease-qty':case 'increase-qty':{
 if(el('order-form'))el('order-form').dataset.dirty='true';const idx=Number(button.dataset.id),item=draft[idx];if(!item)return;
 item.qty=Math.max(1,Math.min(999,item.qty+(action==='increase-qty'?1:-1)));
 const line=button.closest('.item-line');if(line){const input=line.querySelector('.qty-input');if(input)input.value=item.qty;
 const minus=line.querySelector('[data-action="decrease-qty"]'),plus=line.querySelector('[data-action="increase-qty"]');
 if(minus)minus.disabled=item.qty<=1;if(plus)plus.disabled=item.qty>=999;}
 const total=draft.reduce((sum,x)=>sum+(Number(x.qty)||0)*(Number(x.priceCents)||0),0);
 if(el('draft-total'))el('draft-total').textContent=money(total);
 return;}case 'remove-item':if(el('order-form'))el('order-form').dataset.dirty='true';draft.splice(Number(button.dataset.id),1);return renderDraft();case 'refresh':return sync().then(()=>render()).catch(e=>toast(e.message,true));case 'clear-filters':dayFilter='';locationFilter='';orderClientFilter='';closingSearch='';resetPage('pedidos');resetPage('fechamento');return render();case 'export-month-orders':if(allowed('admin','financeiro'))return exportMonthlyText();return;case 'export-month-csv':if(allowed('admin','financeiro'))return exportMonthlyCsv();return;case 'copy-share':{let text=el('share-text').value;navigator.clipboard?.writeText(text).then(()=>toast('Texto copiado.')).catch(()=>{el('share-text').focus();el('share-text').select();toast('Texto selecionado: copie manualmente.')});return}case 'download-share':{let cid=clientGroups()[0]?.cid;let text=el('share-text').value;return download('Extrato_Sabores_das_Divas_'+period+'.txt',text)}case 'open-whatsapp':{let phone=button.dataset.id;if(!/^55\d{10,11}$/.test(phone))return;let text=el('share-text').value;window.open('https://wa.me/'+phone+'?text='+encodeURIComponent(text),'_blank','noopener,noreferrer');return}case 'copy-temp':navigator.clipboard?.writeText(el('temporary-secret').value).then(()=>toast('Senha copiada.')).catch(()=>{el('temporary-secret').select();toast('Senha selecionada: copie manualmente.')});return;case 'export-data':return api('/api/export').then(d=>download('Sabores_Divas_backup_'+today()+'.json',JSON.stringify(d,null,2),'application/json;charset=utf-8')).catch(e=>toast(e.message,true));case 'delete-order':{if(!confirm('Excluir permanentemente este pedido?'))return;return change('/api/orders/'+encodeURIComponent(button.dataset.id),'DELETE',{},'Pedido excluído.')}default:return}}
