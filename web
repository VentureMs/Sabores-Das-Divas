function openOrderDetail(id){let o=db.orders.find(x=>x.id===id);if(!o)return;let paid=orderPaid(o),total=orderTotal(o),due=total-paid;modal(`${head('Pedido · '+dateBR(o.date))}<p><strong>${esc(o.clientName)}</strong> · ${esc(o.location)} · ${esc(o.store||'—')}</p><p class="tiny muted">Responsável pela venda: ${esc(o.createdByName||'Não identificado')}</p>${table(['Item','Qtd.','Preço un.','Subtotal'],o.items.map(i=>`<tr><td>${esc(i.name)}<div class="tiny muted">${esc(i.category)}</div></td><td>${nfmt(i.qty)}</td><td>${money(i.priceCents)}</td><td>${money(i.qty*i.priceCents)}</td></tr>`).join(''))}<div class="total"><span>Total do pedido</span><strong>${money(total)}</strong></div>${allowed('admin','financeiro')?`<div class="soft" style="margin-top:11px">Recebido: ${money(paid)} · Saldo: ${money(due)}</div>`:''}${o.notes?`<p class="soft">${esc(o.notes)}</p>`:''}<div class="footer-buttons">${allowed('admin','financeiro')&&due>0?button('Registrar pagamento','pay-order',o.id,'alt'):''}${allowed('admin','operador','financeiro')&&canEditOrder(o)?button('Editar pedido','edit-order',o.id):''}${allowed('admin')&&paid===0?button('Excluir pedido','delete-order',o.id,'danger'):''}<button class="btn alt" data-close>Fechar</button></div>`,()=>openOrderDetail(id))}
