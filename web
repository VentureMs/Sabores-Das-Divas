'use strict';
const LOCATIONS=['Norte Shopping','Shopping da Pedreira','Outros'];
const CATEGORIES=['Refeição','Sobremesa','Sanduíche'];
const LABEL={admin:'Administrador',operador:'Operador',financeiro:'Financeiro'};
const monthNames=['janeiro','fevereiro','março','abril','maio','junho','julho','agosto','setembro','outubro','novembro','dezembro'];
const money=c=>new Intl.NumberFormat('pt-BR',{style:'currency',currency:'BRL'}).format((c||0)/100);
const today=()=>{const d=new Date();return `${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,'0')}-${String(d.getDate()).padStart(2,'0')}`};
const esc=s=>String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const el=id=>document.getElementById(id);
const nfmt=c=>new Intl.NumberFormat('pt-BR').format(c||0);
const searchKey=value=>String(value??'').normalize('NFD').replace(/[\u0300-\u036f]/g,'').toLocaleLowerCase('pt-BR');
const dateBR=s=>s?.match(/^\d{4}-\d{2}-\d{2}$/)?`${s.slice(8,10)}/${s.slice(5,7)}/${s.slice(0,4)}`:esc(s);
const inputMoney=c=>((c||0)/100).toFixed(2).replace('.',',');
function toCents(s){const x=String(s??'').trim().replace(/\s/g,'').replace(/^R\$/,'').replaceAll('.','').replace(',','.');if(!/^\d+(\.\d{1,2})?$/.test(x))return null;let v=Math.round(Number(x)*100);return Number.isSafeInteger(v)?v:null}
const option=(v,title,selected)=>`<option value="${esc(v)}" ${v===selected?'selected':''}>${esc(title)}</option>`;
const opts=(list,selected,blank='')=>(blank?option('',blank,selected):'')+list.map(x=>option(x,x,selected)).join('');
const field=(id,label,value='',type='text',extra='')=>`<div class="field"><label for="${id}">${esc(label)}</label><input id="${id}" type="${type}" value="${esc(value)}" ${extra}></div>`;
const button=(text,act,id='',cls='alt small')=>`<button type="button" class="btn ${cls}" data-action="${act}" ${id?`data-id="${esc(id)}"`:''}>${esc(text)}</button>`;
function clientDot(c){return c?.inadimplente?'<span class="client-dot red" title="Inadimplência"></span>':c?.notes?.trim()?'<span class="client-dot yellow" title="Observação"></span>':''}
function metric(title,value,sub=''){return `<div class="metric"><span>${esc(title)}</span><strong>${esc(value)}</strong>${sub?`<small>${esc(sub)}</small>`:''}</div>`}
function table(headers,body,colspan=headers.length){return `<div class="tablebox"><table class="gridtable"><thead><tr>${headers.map(x=>`<th>${esc(x)}</th>`).join('')}</tr></thead><tbody>${body||`<tr><td colspan="${colspan}" class="empty">Nenhum registro.</td></tr>`}</tbody></table></div>`}
let me=null,csrf='',db={clients:[],products:[],orders:[]},page='painel',period=today().slice(0,7),locationFilter='',clientSearch='',closingSearch='',draft=[],editingOrder=null,shownClient=null;
let toastTimer;
let dayFilter='', orderClientFilter='', listState={}, modalStack=[], currentModalFactory=null, restoringModal=false, formSaving=false;
const normalizeDay=(day,month)=>day&&day.startsWith(month)?day:'';
function pageSize(key){return listState[key]?.size||20}
function paginate(key,rows){const state=listState[key]||(listState[key]={number:1,size:20});state.size=([20,50,100].includes(state.size)?state.size:20);const total=Math.max(1,Math.ceil(rows.length/state.size));state.number=Math.max(1,Math.min(total,state.number));return {visible:rows.slice((state.number-1)*state.size,state.number*state.size),total:rows.length,page:state.number,pages:total}}
function resetPage(key){if(listState[key])listState[key].number=1}
function pagination(key,data){const state=listState[key];if(!state)return '';return `<div class="pagination"><span>${data.total} registro(s) · Página ${data.page} de ${data.pages}</span><div class="actions"><label>Por página <select data-page-size="${esc(key)}">${[20,50,100].map(n=>option(String(n),String(n),String(state.size))).join('')}</select></label><button type="button" data-list-page="${esc(key)}" data-to="${data.page-1}" class="btn alt small" ${data.page<=1?'disabled':''}>← Anterior</button><button type="button" data-list-page="${esc(key)}" data-to="${data.page+1}" class="btn alt small" ${data.page>=data.pages?'disabled':''}>Próxima →</button></div></div>`}
function filteredDayOrders(){return filterOrders().filter(o=>!dayFilter||o.date===dayFilter)}
function clientName(o){return db.clients.find(c=>c.id===o.clientId)?.name||o.clientName}
function canEditOrder(o){return !!o&&allowed('admin','operador','financeiro')&&orderPaid(o)===0&&!(o.payments||[]).length&&!o.paidLocked&&(me.role==='admin'||o.createdBy===me.id)}
function restoreFocus(elm){if(elm){elm.focus();elm.setSelectionRange?.(elm.value.length,elm.value.length)}}

function toast(text,error=false){let t=el('toast');t.textContent=text;t.className='visible'+(error?' error':'');clearTimeout(toastTimer);toastTimer=setTimeout(()=>t.className='',5500)}
async function api(path,method='GET',body){let init={method,credentials:'same-origin',headers:{}};if(method!=='GET'){init.headers['Content-Type']='application/json';init.headers['X-CSRF-Token']=csrf;init.body=JSON.stringify(body||{})}let r;try{r=await fetch(path,init)}catch(e){throw Error('Sem conexão com o servidor. Confira sua internet e tente novamente.')}let j;try{j=await r.json()}catch(e){throw Error('Servidor retornou dados inválidos.')}if(!r.ok){if(r.status===401 && path!=='/api/login'){me=null;showLogin()}throw Error(j.error||`Falha ${r.status}`)}return j}
async function sync(){db=await api('/api/data')}
function showLogin(){el('login-screen').classList.remove('hidden');el('app').classList.add('hidden');closeModal()}
async function start(){try{let r=await api('/api/me');me=r.user;csrf=r.csrf;await sync();showApp()}catch(err){showLogin()}}
async function showApp(){el('login-screen').classList.add('hidden');el('app').classList.remove('hidden');el('user-badge').textContent=`${me.name} · ${LABEL[me.role]}`;if(me.role==='admin'||me.role==='financeiro')page='painel';else page='pedidos';render()}
function allowed(...roles){return roles.includes(me?.role)}
function navItems(){return [
 ['painel','▦ Painel',['admin','financeiro']],['pedidos','▤ Pedidos',['admin','operador','financeiro']],['clientes','♙ Clientes',['admin','operador','financeiro']],
 ['cardapio','◈ Cardápio',['admin','operador','financeiro']],['fechamento','▣ Fechamento',['admin','financeiro']],
 ['usuarios','♟ Usuários',['admin']],['auditoria','◷ Histórico',['admin']],['dados','⚙ Meus dados',['admin']],['conta','◉ Minha conta',['admin','operador','financeiro']]
 ].filter(x=>x[2].includes(me.role))}
function go(p){if(el('modal-root').querySelector('.modal-back')&&!abandonFormAllowed())return; if(el('modal-root').querySelector('.modal-back'))closeModal();if(!navItems().some(x=>x[0]===p)){toast('Acesso não autorizado.',true);return}page=p;render();window.scrollTo(0,0)}
function render(){el('nav').innerHTML=navItems().map(([id,name])=>`<button class="${id===page?'active':''}" data-nav="${id}">${esc(name)}</button>`).join('');let names={painel:['Painel de vendas','Resumo do mês selecionado.'],pedidos:['Pedidos','Registre vários itens em um único pedido.'],clientes:['Clientes','Contatos, lojas, observações e inadimplência.'],cardapio:['Cardápio','Produtos e preços atuais; pedidos anteriores preservam os preços.'],fechamento:['Fechamento por cliente','Consulte pedidos, gere extratos e registre recebimentos.'],usuarios:['Usuários e permissões','Crie contas individuais, defina funções e revogue acessos.'],auditoria:['Histórico de atividades','Registros de quem alterou informações e quando.'],dados:['Meus dados','Backup, importação e informações sobre o armazenamento.'],conta:['Minha conta','Senha e autenticação em duas etapas.']};let [title,desc]=names[page]||names.pedidos;el('page-title').textContent=title;el('page-desc').textContent=desc;el('side-version')?.replaceChildren(document.createTextNode('v8.0'));el('page-actions').replaceChildren();let fn={painel:renderPainel,pedidos:renderPedidos,clientes:renderClientes,cardapio:renderCardapio,fechamento:renderFechamento,usuarios:renderUsuarios,auditoria:renderAuditoria,dados:renderDados,conta:renderConta}[page];fn?.()}
function pageButton(title,fn){let area=el('page-actions');area.replaceChildren();let b=document.createElement('button');b.className='btn';b.textContent=title;b.onclick=fn;area.append(b)}
function modal(html, factory=null){
 const root=el('modal-root');
 if(root.firstChild && currentModalFactory && !restoringModal)modalStack.push(currentModalFactory);
 currentModalFactory=factory;
 root.innerHTML=`<div class="modal-back"><section class="modal" role="dialog" aria-modal="true">${html}</section></div>`;
 if(modalStack.length){const heading=root.querySelector('.modal-head');if(heading){let b=document.createElement('button');b.type='button';b.className='modal-back-button';b.textContent='←';b.setAttribute('aria-label','Voltar à tela anterior');b.onclick=modalBack;heading.prepend(b)}}
 root.querySelector('.modal-back').onclick=e=>{if(e.target.classList.contains('modal-back'))toast('Use Voltar ou Fechar para sair desta janela.',true)};
 root.querySelectorAll('[data-close]').forEach(b=>b.onclick=()=>requestModalClose());
 root.querySelectorAll('form').forEach(form=>{form.dataset.dirty='false';form.addEventListener('input',()=>{form.dataset.dirty='true'});form.addEventListener('change',()=>{form.dataset.dirty='true'})});
}
function head(title){return `<div class="modal-head"><h3>${esc(title)}</h3><button class="close" type="button" data-close aria-label="Fechar">×</button></div>`}
function closeModal(){el('modal-root').replaceChildren();modalStack=[];currentModalFactory=null;restoringModal=false}
function abandonFormAllowed(){return ![...el('modal-root').querySelectorAll('form')].some(form=>form.dataset.dirty==='true')||confirm('Existem alterações não salvas. Deseja descartá-las?')}
function requestModalClose(){if(abandonFormAllowed())closeModal()}
function modalBack(){if(!abandonFormAllowed())return;if(!modalStack.length){closeModal();return}const factory=modalStack.pop();restoringModal=true;try{factory()}finally{restoringModal=false}}
async function change(path,method,payload,msg='Registro salvo.'){try{let res=await api(path,method,payload);await sync();closeModal();render();toast(msg);return res}catch(e){toast(e.message,true);return null}}
function orderTotal(o){return (o.items||[]).reduce((sum,i)=>sum+i.qty*i.priceCents,0)}
function orderPaid(o){return (o.payments||[]).reduce((sum,p)=>sum+p.amountCents,0)}
function filterOrders(){return db.orders.filter(o=>o.date.startsWith(period)&&(!locationFilter||o.location===locationFilter))}
function totals(orders){let total=orders.reduce((s,o)=>s+orderTotal(o),0),paid=orders.reduce((s,o)=>s+orderPaid(o),0);return {orders:orders.length,total,paid,due:total-paid}}
function filters(withDay=false){return `<section class="card filter"><div class="field"><label>Mês / ano</label><input type="month" id="month-filter" value="${esc(period)}"></div><div class="field"><label>Local de venda</label><select id="location-filter">${opts(LOCATIONS,locationFilter,'Todos os locais')}</select></div>${withDay?`<div class="field"><label>Dia específico (opcional)</label><input type="date" id="day-filter" min="${esc(period)}-01" max="${esc(period)}-31" value="${esc(normalizeDay(dayFilter,period))}"></div>${page==='pedidos'?`<div class="field"><label>Cliente específico</label><select id="order-client-filter">${option('','Todos os clientes',orderClientFilter)}${[...db.clients].sort((a,b)=>a.name.localeCompare(b.name,'pt-BR')).map(c=>option(c.id,c.name+(c.store?' · '+c.store:''),orderClientFilter)).join('')}</select></div>`:''}`:''}<div class="actions">${button('Limpar filtros','clear-filters','','alt small')}</div></section>`}
function periodHandlers(){el('month-filter')?.addEventListener('change',e=>{period=e.target.value||today().slice(0,7);dayFilter='';resetPage('pedidos');resetPage('fechamento');render()});el('location-filter')?.addEventListener('change',e=>{locationFilter=e.target.value;resetPage('pedidos');resetPage('fechamento');render()});el('day-filter')?.addEventListener('change',e=>{dayFilter=normalizeDay(e.target.value,period);resetPage('pedidos');render()});el('order-client-filter')?.addEventListener('change',e=>{orderClientFilter=e.target.value;resetPage('pedidos');render()})}
function renderPainel(){let rows=filteredDayOrders(),t=totals(rows);let per=LOCATIONS.map(loc=>({loc,...totals(rows.filter(o=>o.location===loc))}));el('content').innerHTML=filters(true)+`<div class="metrics">${metric('Faturamento',money(t.total))}${metric('Pedidos',nfmt(t.orders))}${metric('Recebido dos pedidos',money(t.paid))}${metric('A receber',money(t.due))}</div><section class="card"><h3>Vendas por local ${dayFilter?'· '+dateBR(dayFilter):''}</h3><div class="metrics">${per.map(x=>metric(x.loc,money(x.total),`${x.orders} pedidos`)).join('')}</div></section>`;periodHandlers()}
function renderClientes(){if(allowed('admin','operador','financeiro'))pageButton('+ Cadastrar cliente · Ctrl+Alt+N',()=>openClient());let count=LOCATIONS.map(loc=>db.clients.filter(c=>c.location===loc).length);let filtered=db.clients.filter(c=>(!locationFilter||c.location===locationFilter)&&(!clientSearch||[c.name,c.phone,c.store,c.notes].some(x=>searchKey(x).includes(searchKey(clientSearch))))).sort((a,b)=>a.name.localeCompare(b.name,'pt-BR'));let pg=paginate("clientes",filtered);let rows=pg.visible.map(c=>`<tr><td><strong>${clientDot(c)}${esc(c.name)}</strong></td><td>${esc(c.location)}</td><td>${esc(c.store||'—')}</td><td>${esc(c.phone||'Não informado')}</td><td>${allowed('admin','operador','financeiro')?`<div class="actions">${button('Editar','edit-client',c.id)}${allowed('admin')?button('Excluir','delete-client',c.id,'danger small'):''}</div>`:'—'}</td></tr>`).join('');el('content').innerHTML=`<div class="metrics">${LOCATIONS.map((loc,i)=>metric(loc,nfmt(count[i]))).join('')}${metric('Total de clientes',nfmt(db.clients.length))}</div><div class="card"><div class="filter" style="margin-bottom:15px"><div class="field"><label>Buscar cliente, loja ou telefone</label><input id="client-search" value="${esc(clientSearch)}" type="search" placeholder="Nome, telefone ou loja"></div><div class="field"><label>Local de venda</label><select id="client-location-filter">${opts(LOCATIONS,locationFilter,'Todos os locais')}</select></div></div><p class="tiny muted" id="client-count">Exibindo ${filtered.length} cliente(s).</p>${table(['Cliente','Local de venda','Loja','Telefone','Ação'],rows)}${pagination('clientes',pg)}</div>`;el('client-search').oninput=e=>{clientSearch=e.target.value;resetPage('clientes');renderClientes();el('client-search').focus();el('client-search').setSelectionRange(clientSearch.length,clientSearch.length)};el('client-location-filter').onchange=e=>{locationFilter=e.target.value;resetPage('clientes');renderClientes()}}
function openClient(id){if(!allowed('admin','operador','financeiro'))return;let c=db.clients.find(x=>x.id===id);modal(`${head(c?'Editar cliente':'Cadastrar cliente')}<form id="client-form"><div class="row">${field('c-name','Nome do cliente',c?.name||'','','required maxlength="100"')}<div class="field"><label>Local de venda</label><select id="c-location">${opts(LOCATIONS,c?.location||LOCATIONS[0])}</select></div></div><div class="row" style="margin-top:11px">${field('c-store','Loja',c?.store||'','','maxlength="120"')}${field('c-phone','Telefone (opcional)',c?.phone||'','tel','maxlength="32" placeholder="(21) 99999-9999" inputmode="tel"')}</div><div class="field" style="margin-top:11px"><label>Observações</label><textarea id="c-notes" maxlength="2000">${esc(c?.notes||'')}</textarea></div>${allowed('admin','financeiro')?`<label style="display:flex;align-items:center;gap:10px;margin-top:12px"><input id="c-delinquent" type="checkbox" ${c?.inadimplente?'checked':''}> Marcar inadimplência (bolinha vermelha; prioridade sobre observações)</label>`:`<p class="tiny muted">A inadimplência somente pode ser alterada pelo administrador ou financeiro.</p>`}<div class="footer-buttons"><button type="button" class="btn alt" data-close>Cancelar</button><button class="btn">Salvar</button></div></form>`);requestAnimationFrame(()=>el('c-name')?.focus());el('c-phone').onblur=()=>{let digits=el('c-phone').value.replace(/\D/g,'');if(digits.startsWith('55')&&(digits.length===12||digits.length===13))digits=digits.slice(2);if(digits.length===11)el('c-phone').value=`(${digits.slice(0,2)}) ${digits.slice(2,7)}-${digits.slice(7)}`;else if(digits.length===10)el('c-phone').value=`(${digits.slice(0,2)}) ${digits.slice(2,6)}-${digits.slice(6)}`};el('client-form').onsubmit=async e=>{e.preventDefault();let d={name:el('c-name').value,location:el('c-location').value,store:el('c-store').value,phone:el('c-phone').value,notes:el('c-notes').value,inadimplente:allowed('admin','financeiro')?el('c-delinquent').checked:false};if(!allowed('admin','financeiro')&&c)d.inadimplente=!!c.inadimplente;
const dial=d.phone.replace(/\D/g,'').replace(/^55(?=\d{10,11}$)/,'');
const oldDial=(c?.phone||'').replace(/\D/g,'').replace(/^55(?=\d{10,11}$)/,'');
const match=dial&&dial!==oldDial&&db.clients.find(x=>x.id!==c?.id&&x.phone.replace(/\D/g,'').replace(/^55(?=\d{10,11}$)/,'')===dial);
if(match){toast('Telefone já cadastrado para '+match.name+'. Verifique antes de salvar.',true);el('c-phone').focus();return}
await change(c?'/api/clients/'+encodeURIComponent(c.id):'/api/clients',c?'PATCH':'POST',d,'Cliente salvo.')}}
function renderCardapio(){if(allowed('admin'))pageButton('+ Cadastrar produto',()=>openProduct());el('content').innerHTML=`<div class="card"><p class="muted">Refeições, sobremesas e sanduíches têm preço fixo no cardápio. Adicionais são criados diretamente no pedido.</p>${table(['Produto','Categoria','Preço','Situação','Ação'],paginate('cardapio',db.products.filter(p=>!p.archived)).visible.map(p=>`<tr><td>${esc(p.name)}</td><td>${esc(p.category)}</td><td>${money(p.priceCents)}</td><td><span class="pill ${p.active?'ok':'due'}">${p.active?'Disponível':'Indisponível'}</span></td><td>${allowed('admin')?`<div class="actions">${button('Editar','edit-product',p.id)}${button('Excluir','delete-product',p.id,'danger small')}</div>`:'—'}</td></tr>`).join(''))}${pagination('cardapio',paginate('cardapio',db.products.filter(p=>!p.archived)))}</div>`}
function openProduct(id){if(!allowed('admin'))return;let p=db.products.find(x=>x.id===id);modal(`${head(p?'Editar produto':'Cadastrar produto')}<form id="product-form"><div class="row">${field('p-name','Nome do produto',p?.name||'','text','required maxlength="110"')}<div class="field"><label>Categoria</label><select id="p-category">${opts(CATEGORIES,p?.category||CATEGORIES[0])}</select></div></div><div class="row" style="margin-top:12px">${field('p-price','Preço (R$)',p?inputMoney(p.priceCents):'','text','required inputmode="decimal"')}<div class="field"><label>Disponibilidade</label><select id="p-active"><option value="yes" ${!p||p.active?'selected':''}>Disponível</option><option value="no" ${p&&!p.active?'selected':''}>Indisponível</option></select></div></div><div class="footer-buttons"><button type="button" class="btn alt" data-close>Cancelar</button><button class="btn">Salvar</button></div></form>`);el('product-form').onsubmit=async e=>{e.preventDefault();let price=toCents(el('p-price').value);if(price===null){toast('Informe preço válido, por exemplo: 15,99.',true);return}await change(p?'/api/products/'+encodeURIComponent(p.id):'/api/products',p?'PATCH':'POST',{name:el('p-name').value,category:el('p-category').value,priceCents:price,active:el('p-active').value==='yes'},'Produto salvo.')}}
