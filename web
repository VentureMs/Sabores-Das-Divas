/* Controles de quantidade para telas pequenas e grandes: nenhuma digitação necessária. */
.item-line{grid-template-columns:minmax(120px,2fr) minmax(138px,.8fr) minmax(105px,1fr) auto}
.qty-field{min-width:132px}
.qty-controls{display:flex;align-items:stretch;gap:4px;min-width:0}
.qty-controls .qty-step{flex:0 0 40px;min-height:43px;border:1px solid #d8a8bf;border-radius:9px;background:#fff0f6;color:#92234d;font-size:23px;font-weight:800;touch-action:manipulation}
.qty-controls .qty-input{flex:1 1 35px;min-width:34px;padding:5px 1px;text-align:center;font-weight:750;pointer-events:none}
@media(max-width:740px){.item-line{grid-template-columns:minmax(0,1fr) minmax(136px,.8fr)}.item-line .qty-field{min-width:136px}}
@media(max-width:380px){.item-line{grid-template-columns:minmax(0,1fr)}.item-line .extra-name{grid-column:1}.item-line .qty-field{min-width:0}}

/* v8: cores suaves de quitação, paginação e navegação dos diálogos */
.gridtable tbody tr.row-paid, .gridtable tbody tr.row-paid:hover{background:#eaf7ee}
.pagination{display:flex;gap:12px;align-items:center;justify-content:space-between;flex-wrap:wrap;margin-top:15px;font-size:13px;color:var(--muted)}
.pagination label{display:flex;align-items:center;gap:8px;font-size:13px}
.pagination select{width:auto;min-width:70px;min-height:34px;padding:5px 8px}
.modal-back-button{background:#fff0f6;border:1px solid #e7c6d5;color:var(--pink);border-radius:9px;min-height:36px;min-width:40px;font-size:24px;font-weight:700}
.modal-head h3{flex:1}
@media(max-width:740px){.pagination .actions{width:100%;justify-content:space-between}.pagination .actions .btn{flex:0 0 auto}}
