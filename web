function historicalClient(cid,orders){return db.clients.find(c=>c.id===cid)||{id:cid,name:orders[0]?.clientName||'Cliente excluído',location:orders[0]?.location||'',store:orders[0]?.store||'',phone:'',notes:'',inadimplente:false,archived:true}}
