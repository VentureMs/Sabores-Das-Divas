 if((e.ctrlKey||e.metaKey)&&e.altKey&&!e.shiftKey&&e.key.toLowerCase()==='n'&&page==='clientes'&&me&&allowed('admin','operador','financeiro')&&!el('modal-root').querySelector('.modal-back')){
