function renderUsuarios(){pageButton('+ Adicionar usuário',()=>openInvite());el('content').innerHTML=`<div class="notice">O nome da pessoa é também o usuário para login; o e-mail é uma alternativa de acesso. A senha provisória tem 6 dígitos e pode continuar sendo usada, sem obrigatoriedade de troca. É recomendável ativar duas etapas. Ao excluir um acesso, os pedidos e pagamentos feitos por ele permanecem registrados.</div><div class="card" id="users-table">Carregando usuários…</div>`;api('/api/users').then(r=>{el('users-table').innerHTML=table(['Nome / usuário','E-mail','Perfil','Situação','2 etapas','Ação'],paginate('usuarios',r.users).visible.map(u=>`<tr><td>${esc(u.name)}</td><td>${esc(u.email)}</td><td>${esc(LABEL[u.role])}</td><td><span class="pill ${u.active?'ok':'due'}">${u.active?'Ativo':'Desativado'}</span></td><td>${u.totpEnabled?'Ativo':'Não'}</td><td><div class="actions">${button('Editar','edit-user',u.id)}${u.id!==me.id?button('Nova senha','reset-user',u.id):''}${u.id!==me.id?button('Excluir','delete-user',u.id,'alt small'):''}</div></td></tr>`).join(''))+pagination('usuarios',paginate('usuarios',r.users));window.__users=r.users}).catch(e=>toast(e.message,true))}
